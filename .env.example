# ─────────────────────────────────────────────────────────────
# AI API 质量评测平台 — 可选环境变量
# 复制为 .env.local 后按需修改（全部可选，不配置也能正常运行）
# ─────────────────────────────────────────────────────────────

# 本地 CORS 代理 sidecar 的基地址。
# 当某个 Provider 的 transport 设为 proxy 时，请求会转发到这里。
# 需先执行：npm run proxy
VITE_PROXY_BASE=http://localhost:8787

# 引擎版本号标识，会写入每份 EvaluationResult（可复现性铁律 §7.10）
VITE_ENGINE_VERSION=1.0.0

# 新建 Provider 时的默认传输方式：direct | proxy
VITE_DEFAULT_TRANSPORT=direct

# 是否在启动时打印调试日志（true/false）
VITE_DEBUG=false
